. /lib/functions/leds.sh
. /lib/functions/uci-defaults.sh

board=$(board_name)

board_config_update

case $board in
ZX7981EP)
	ucidef_set_led_netdev "lan" "lan" "lede:blue:lan" "eth1"
	ucidef_set_led_netdev "wan" "wan" "lede:blue:wan" "wan"
	ucidef_set_led_netdev "lan1" "lan1" "lede:blue:lan1" "lan1"
	ucidef_set_led_netdev "lan2" "lan2" "lede:blue:lan2" "lan2"
	ucidef_set_led_netdev "lan3" "lan3" "lede:blue:lan3" "lan3"
	ucidef_set_led_netdev "lan4" "lan4" "lede:blue:lan4" "lan4"
	;;
esac

board_config_flush

exit 0
